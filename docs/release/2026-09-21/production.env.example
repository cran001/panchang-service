# Configuration TEMPLATE ONLY. Does not provision, deploy, trust a reviewer, or approve guidance.
HOST=127.0.0.1
PORT=8080
# Replace with an operator-owned persistent LOCAL filesystem directory outside the web root.
# API and file exporter on the same host may share this exact directory.
# Requires file locks and atomic rename. Do not use NFS, object storage, or CDN storage here.
PANCHANG_CALC_CACHE_DIR=/var/lib/panchang/calculations
PANCHANG_APPROVAL_MODE=disabled
# There are deliberately no journal credentials or production-approval enable switches.
# Unset PANCHANG_CALC_CACHE_DIR disables caching. A blank directory or non-disabled approval mode is rejected.
